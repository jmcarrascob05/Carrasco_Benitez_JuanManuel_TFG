FROM debian:12-slim

RUN apt-get update && apt-get install -y \
    nginx \
    php8.2-fpm \
    php8.2-mysql \
    php8.2-mbstring \
    php8.2-xml \
    && rm -rf /var/lib/apt/lists/*

# PHP-FPM escucha en TCP 9000 (consistente con nginx-web.conf)
RUN sed -i 's|listen = .*|listen = 127.0.0.1:9000|' /etc/php/8.2/fpm/pool.d/www.conf

# El proceso PHP-FPM corre como www-data (igual que nginx)
RUN sed -i 's|^user = .*|user = www-data|' /etc/php/8.2/fpm/pool.d/www.conf && \
    sed -i 's|^group = .*|group = www-data|' /etc/php/8.2/fpm/pool.d/www.conf

# Directorio app
RUN mkdir -p /var/www/rustyx

# Script de arranque
COPY start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 80

CMD ["/start.sh"]